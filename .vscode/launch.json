{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "[Debuggea]: Lanza el debugger en el archivo actual",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "args": "${command:pickArgs}",
            "console": "integratedTerminal",
            // Sólo debuggea mi código, no librerías externas
            "justMyCode": true
        },
        {
            "name": "[Gradio]: Lanza la app de Gradio",
            "type": "debugpy",
            "request": "launch",
            "module": "src.miia_pec1.ui.app",
            "args": [],
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}