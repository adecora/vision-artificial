{
  // No mas dolores de cabeza windows-linux
  "files.eol": "\n",

  // Configuración de Python
  "[python]": {
    // Espacios en lugar de tabs
    "editor.insertSpaces": true,
    "editor.tabSize": 4,
    "editor.formatOnSave": false,
    "editor.codeActionsOnSave": {
      // "source.fixAll": "explicit",
      "source.organizeImports": "explicit"
    },
    "editor.defaultFormatter": "charliermarsh.ruff",
  },
  "python.terminal.activateEnvironment": true,
  // Usa la varibles de entorno del fichero .env en la terminal de VSCode
  // Como el .env reescribe la variable PATH, no es recomendable usarlo para activar el entorno virtual, ya que puede causar problemas con la terminal integrada de VSCode.
  // "python.envFile": "${workspaceFolder}/.env",
  // "python.terminal.useEnvFile": true,
  // Fuera las sugerencias que porcuelan de ty
  "ty.inlayHints.variableTypes": false,
  "ty.inlayHints.callArgumentNames": true,
  // Si te despistas termina importando paquetes random
  "ty.completions.autoImport": false,

  // nice para no fumarse líneas inleíbles
  "editor.rulers": [88, 120],

  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.analysis.autoFormatStrings": true,
  // Para que el linter y el autocompletado funcionen con el código dentro de la carpeta del proyecto
  "python.analysis.extraPaths": [ "${workspaceFolder}/src" ],

  // Configuración de Notebooks
  "notebook.defaultFormatter": "charliermarsh.ruff",
  "notebook.formatOnSave.enabled": false,
  "notebook.insertFinalNewline": false,
  "notebook.output.scrolling": true,
  "notebook.lineNumbers": "on",
  "notebook.scrolling.revealNextCellOnExecute": "none",
  "notebook.source.organizeImports": "explicit",
  "notebook.editorOptionsCustomizations": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },

  // Configuración de Zen Mode
  "zenMode.centerLayout": false,
  "zenMode.hideLineNumbers": false,

  // Asocia ficheros .qmd a Quarto cuando la extensión está instalada.
  "files.associations": {
    "*.qmd": "quarto"
  },

  // No formatear automáticamente notebooks/Quarto al guardar
  "editor.formatOnSave": false,

  // Oculta cachés y artefactos generados del explorador de VS Code
  "files.exclude": {
    "**/.ipynb_checkpoints": true,
    "**/.quarto": true,
    "**/_freeze": true,
    "**/__pycache__": true,
    "slides/*_files": true
  },

  // Omite cachés y artefactos generados en las búsquedas
  "search.exclude": {
    "**/.ipynb_checkpoints": true,
    "**/.quarto": true,
    "**/_freeze": true,
    "**/__pycache__": true,
    "**/*_files": true,
    "httdocs": true
  },

  // spell check para reducir mis coladas
  "cSpell.enabled": true,
  "cSpell.language": "en,es-ES",
  "cSpell.enabledFileTypes": {
    "*": true,
    "markdown": true,
    "python": true
  }
}
